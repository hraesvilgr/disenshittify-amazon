{
  "manifest_version": 3,
  "name": "Disenshittify Amazon",
  "version": "0.9.3",
  "description": "Rates Amazon search results by trustworthiness, tints them green to red, and sorts the junk to the bottom.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/s*",
        "https://amazon.com/s*",
        "https://www.amazon.com/dp/*",
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/gp/product/*",
        "https://amazon.com/dp/*",
        "https://amazon.com/*/dp/*",
        "https://amazon.com/gp/product/*"
      ],
      "js": [
        "src/config.js",
        "src/brands.js",
        "src/bigrams.js",
        "src/scorer.js",
        "src/memory.js",
        "src/product.js",
        "src/pricecheck.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "disenshittify-amazon@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
